{
  "info": {
    "_postman_id": "c0113b0a-0000-4a00-9000-collabboard01",
    "name": "CollabBoard API",
    "description": "End-to-end REST collection for the CollabBoard server (BUILD_SPEC §3). Auth is Bearer at the collection level; Register/Login capture the access token into {{accessToken}} and later requests chain {{workspaceId}}, {{boardId}}, {{snapshotId}}, {{shareToken}} automatically. Refresh relies on the httpOnly cookie the runner keeps in its cookie jar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "accessToken", "value": "" },
    { "key": "demoEmail", "value": "" },
    { "key": "demoPassword", "value": "Password123!" },
    { "key": "demoName", "value": "Demo User" },
    { "key": "userId", "value": "" },
    { "key": "workspaceId", "value": "" },
    { "key": "boardId", "value": "" },
    { "key": "snapshotId", "value": "" },
    { "key": "shareToken", "value": "" },
    { "key": "shareLinkId", "value": "" },
    { "key": "inviteToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('demoEmail')) {",
                  "  pm.collectionVariables.set('demoEmail', 'demo_' + Date.now() + '@collabboard.dev');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('registered', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "if (res && res.accessToken) { pm.collectionVariables.set('accessToken', res.accessToken); }",
                  "if (res && res.user && res.user.id) { pm.collectionVariables.set('userId', res.user.id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"name\": \"{{demoName}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('logged in', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (res && res.accessToken) { pm.collectionVariables.set('accessToken', res.accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('refreshed', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (res && res.accessToken) { pm.collectionVariables.set('accessToken', res.accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Uses the refresh cookie kept in the runner's cookie jar; returns a fresh access token."
          }
        },
        {
          "name": "Resend Verification",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-verification",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "resend-verification"]
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"paste-token-from-dev-email-console\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-email"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Revokes the refresh token and clears the cookie (204)."
          }
        }
      ]
    },
