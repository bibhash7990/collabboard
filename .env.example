# ─── Shared ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Server ───────────────────────────────────────────────────────────────
PORT=4000
# Public URL of the web client (used for CORS + email links)
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/collabboard
# Only if your network's resolver can't do SRV lookups for a mongodb+srv:// URI:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Redis (pub/sub + socket.io adapter). Leave empty to run single-node without Redis.
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-please-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Refresh cookie
COOKIE_NAME=cb_refresh
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# 'lax' when the frontend is same-origin as the API (production single-service).
# Use 'none' only if the frontend is on a different domain (then COOKIE_SECURE must be true).
COOKIE_SAMESITE=lax

# Production only: when set, the server also serves the built SPA from this dir
# (single-origin deploy). Leave unset in local dev — Vite serves the SPA on :5173.
# WEB_DIST=/app/apps/web/dist

# Email verification (dev uses a console/Ethereal transport)
EMAIL_FROM="CollabBoard <no-reply@collabboard.dev>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# AI action-items service (mock). If empty, an internal deterministic mock is used.
AI_SERVICE_URL=

# Public share-link signing
SHARE_LINK_SECRET=change-me-share-link-secret

# ─── Web (Vite — must be prefixed with VITE_) ───────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
